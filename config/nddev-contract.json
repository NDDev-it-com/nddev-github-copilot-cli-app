{
  "contract_version": 2,
  "product_name": "nddev-github-copilot-cli-app",
  "github_repository": "NDDev-it-com/nddev-github-copilot-cli-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "managed_state": {
    "stamp_file": "NDDEV-GITHUB-COPILOT-CLI-SETUP.json",
    "stamp_schema": 1,
    "managed_file_mode": "0600",
    "managed_files": [
      "settings.json",
      "permissions-config.json",
      "copilot-instructions.md",
      "instructions/nddev-builder.instructions.md",
      "mcp-config.json"
    ],
    "managed_tree_roots": ["plugins/nddev-builder", "skills/nddev-builder", "agents", "hooks", "instructions"],
    "preserve_other_state": true
  },
  "setup_system": {
    "catalog_root": "setups",
    "identity_source": "setups/<setup-id>/setup.json",
    "setup_ids": ["safe", "balanced", "full-auto"],
    "selection_option": "--setup <safe|balanced|full-auto>",
    "list_command": "python3 cli-tools/nddev_github_copilot_cli.py list [--json]",
    "status_command": "python3 cli-tools/nddev_github_copilot_cli.py status --target <absolute-target> [--json]",
    "launch_command": "python3 cli-tools/nddev_github_copilot_cli.py launch --target <absolute-target> -- [args...]",
    "builder_default_on": true
  },
  "safety": {
    "explicit_target_required": true,
    "absolute_target_required": true,
    "relative_target_rejected": true,
    "missing_target_argument_rejected": true,
    "target_symlinks_rejected": true,
    "home_expansion_rejected": true,
    "target_parent_private_required": true,
    "dangling_symlinks_fail_closed": true,
    "hardlinks_rejected": true,
    "canonical_target_binding": true,
    "default_target": null,
    "max_backups": 10,
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "backup_pool_marker": "NDDEV-GITHUB-COPILOT-CLI-BACKUPS.json",
    "preexisting_backup_pool_collision": "fail-closed-no-delete",
    "unique_transaction_directories": true,
    "created_transaction_paths_cleaned_exactly": true,
    "rollback_snapshot": "managed bytes restored with 0600 managed-file modes",
    "rollback_on_failure": true
  },
  "runtime_compatibility": {
    "baseline_ref": "references/copilot-cli-baseline.json",
    "version_ref": "build/version.json",
    "tested_version": "1.0.75",
    "release_tag": "v1.0.75",
    "documentation": [
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference",
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-config-dir-reference",
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-plugin-reference"
    ]
  },
  "runtime_launch": {
    "command": "<absolute-target>/bin/copilot",
    "direct_command": "COPILOT_HOME=<absolute-target> COPILOT_CACHE_HOME=<absolute-target>/cache <absolute-target>/bin/copilot [setup launch args] [args...]",
    "home_environment_variable": "COPILOT_HOME",
    "cache_environment_variable": "COPILOT_CACHE_HOME",
    "executable_source": "validated-target-owned-github-release-asset",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_github_copilot_cli.py launch --target <absolute-target> -- [args...]",
    "requires_clean_managed_target": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "environment_scope": "child-process-only",
    "token_environment_inheritance": "stripped",
    "environment_inheritance": "minimal-allowlist-plus-test-fixture-vars",
    "preflight_lock": "exclusive target sibling lock for validation",
    "lock_released_before_child": true,
    "blocks_user_managed_flags": [
      "--add-dir",
      "--add-github-mcp-tool",
      "--add-github-mcp-toolset",
      "--additional-mcp-config",
      "--agent",
      "--allow-all",
      "--allow-all-mcp-server-instructions",
      "--allow-all-paths",
      "--allow-all-tools",
      "--allow-all-urls",
      "--allow-tool",
      "--allow-url",
      "--autopilot",
      "--available-tools",
      "--bash-env",
      "--config-dir",
      "--connect",
      "--context",
      "--deny-tool",
      "--deny-url",
      "--disable-builtin-mcps",
      "--disable-mcp-server",
      "--disallow-temp-dir",
      "--effort",
      "--enable-all-github-mcp-tools",
      "--enable-memory",
      "--max-autopilot-continues",
      "--mode",
      "--model",
      "--plan",
      "--reasoning-effort",
      "--resume",
      "--worktree",
      "--yolo",
      "-C",
      "-w"
    ]
  },
  "software_install": {
    "tested_version": "1.0.75",
    "supported_platforms": ["macos", "linux", "linuxmusl"],
    "source": "github.com/github/copilot-cli release assets",
    "installer": {
      "url": "https://gh.io/copilot-install",
      "sha256": "cd45508981a9baee5fb8f5e38495d315758cd7fea4a715b53a9f26c12544dc95",
      "size": 6922
    },
    "layout": {
      "visible_command": "bin/copilot",
      "software_manifest": "software/copilot-cli.json"
    },
    "update_precondition": "installed-or-safe-repairable-partial-target",
    "absent_update_policy": "domain-failure-install-first-zero-artifacts",
    "stage_policy": "unique-private-mkdtemp-under-target-parent",
    "pre_network_preflight": "target-parent-current-user-owned-mode-0700-no-follow",
    "commands": {
      "plan": "python3 cli-tools/nddev_github_copilot_cli.py software-plan --target <absolute-target> [--json]",
      "status": "python3 cli-tools/nddev_github_copilot_cli.py software-status --target <absolute-target> [--json]",
      "install": "python3 cli-tools/nddev_github_copilot_cli.py software-install --target <absolute-target> [--json]",
      "update": "python3 cli-tools/nddev_github_copilot_cli.py software-update --target <absolute-target> [--json]"
    }
  },
  "builder_capability": {
    "projection": "copilot-native-plugin-user-files",
    "source_root": "plugins/nddev-builder",
    "manifest": "plugins/nddev-builder/plugin.json",
    "version_ref": "build/version.json:nddev_builder_plugin_version",
    "native_paths": ["plugin.json", "skills", "agents", "hooks.json"],
    "user_projection_paths": ["skills/nddev-builder", "agents/nddev-builder.agent.md", "hooks/nddev-builder.json"],
    "skills": ["nddev-builder"],
    "agents": ["nddev-builder"],
    "hooks": ["nddev-builder"],
    "default_on": true,
    "marketplace": null
  }
}
