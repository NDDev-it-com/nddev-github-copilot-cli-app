{
  "schema_version": 2,
  "name": "nddev-github-copilot-cli-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_github_copilot_cli.py",
  "source_root": "setups",
  "setup_ids": ["nddev-builder"],
  "default_setup": "nddev-builder",
  "profile_root": "profiles",
  "profile_ids": ["full-auto", "safe"],
  "default_profile": "full-auto",
  "operation_intent": {
    "install": "absent-or-unmanaged-target-only",
    "update": "current-clean-schema-target-current-selection-only",
    "switch": "current-clean-schema-target-only",
    "migrate": "legacy-managed-target-only"
  },
  "managed_files": [
    "settings.json",
    "permissions-config.json",
    "copilot-instructions.md",
    "instructions/nddev-builder.instructions.md",
    "mcp-config.json",
    "NDDEV-GITHUB-COPILOT-CLI-SETUP.json"
  ],
  "legacy_read_only_managed_files": [
    "settings.json",
    "permissions-config.json",
    "copilot-instructions.md",
    "instructions/nddev-builder.instructions.md",
    "mcp-config.json",
    "plugins/nddev-builder/plugin.json",
    "plugins/nddev-builder/skills/nddev-builder/SKILL.md",
    "plugins/nddev-builder/agents/nddev-builder.agent.md",
    "plugins/nddev-builder/hooks.json",
    "skills/nddev-builder/SKILL.md",
    "agents/nddev-builder.agent.md",
    "hooks/nddev-builder.json",
    "NDDEV-GITHUB-COPILOT-CLI-SETUP.json"
  ],
  "permission_policy": {
    "configuration_surface": "settings.json, permissions-config.json, and manager-owned launch arguments",
    "setup_source": "setups/nddev-builder",
    "profile_source": "profiles/<profile-id>",
    "profiles": {
      "full-auto": {
        "default": true,
        "settings_ref": "profiles/full-auto/settings.json",
        "permissions_ref": "profiles/full-auto/permissions-config.json",
        "launch_args_ref": "profiles/full-auto/profile.json:launch_args",
        "bypass_disabled": false,
        "sandbox_enabled": false,
        "autopilot_default": true
      },
      "safe": {
        "default": false,
        "settings_ref": "profiles/safe/settings.json",
        "permissions_ref": "profiles/safe/permissions-config.json",
        "launch_args_ref": "profiles/safe/profile.json:launch_args",
        "bypass_disabled": true,
        "sandbox_enabled": true,
        "autopilot_default": false
      }
    },
    "undocumented_memory_toggle": false
  },
  "builder_capability": {
    "mode": "copilot-native-local-marketplace-install",
    "source_root": "marketplaces/nddev-builder",
    "marketplace_manifest": "marketplaces/nddev-builder/.github/plugin/marketplace.json",
    "plugin_root": "marketplaces/nddev-builder/plugins/nddev-builder",
    "plugin_manifest": "marketplaces/nddev-builder/plugins/nddev-builder/plugin.json",
    "plugin_spec": "nddev-builder@nddev-builder",
    "installed_root": "installed-plugins/nddev-builder/nddev-builder",
    "native_commands": [
      "copilot plugin marketplace add <module-root>/marketplaces/nddev-builder",
      "copilot plugin install nddev-builder@nddev-builder"
    ],
    "default_on": true,
    "manual_runtime_projection": false,
    "prelogin_proof": {
      "copilot_home": "<target>",
      "copilot_cache_home": "<target>/cache",
      "offline": true,
      "token_environment_inheritance": "stripped",
      "ambient_gh_fallback": "blocked"
    }
  },
  "runtime_compatibility": {
    "baseline_ref": "references/copilot-cli-baseline.json",
    "version_ref": "build/version.json",
    "tested_version": "1.0.75",
    "release_tag": "v1.0.75",
    "documentation": [
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference",
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-config-dir-reference",
      "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-plugin-reference",
      "https://docs.github.com/en/copilot/reference/hooks-reference"
    ]
  },
  "runtime_launch": {
    "command": "<absolute-target>/bin/copilot",
    "direct_command": "COPILOT_HOME=<absolute-target> COPILOT_CACHE_HOME=<absolute-target>/cache <absolute-target>/bin/copilot [profile launch args] [args...]",
    "home_environment_variable": "COPILOT_HOME",
    "cache_environment_variable": "COPILOT_CACHE_HOME",
    "executable_source": "validated-target-owned-github-release-asset",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_github_copilot_cli.py launch --target <absolute-target> -- [args...]",
    "requires_clean_managed_target": true,
    "requires_current_builder_plugin": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "environment_scope": "child-process-only",
    "token_environment_inheritance": "stripped",
    "environment_inheritance": "minimal-locale-and-terminal-allowlist",
    "ambient_gh_fallback": "blocked",
    "preflight_lock": "host preflight and lexical target validation precede product bootstrap coordination; canonical-target external flock is acquired before target inspection; target-internal lifecycle flock is held through mutation or launch cleanup when needed",
    "lock_released_before_child": false,
    "lock_held_through_child_completion": true,
    "executable_revalidation": "target-owned executable identity and sha256 rechecked with O_NOFOLLOW fd evidence after argv/env construction before Popen",
    "executable_handoff": "write-protected verified-path handoff; no portable fd execution claimed under same-UID no-sandbox boundary",
    "external_bootstrap_tampering_boundary": "deliberate same-UID tampering of the fixed bootstrap root remains outside no-sandbox guarantees",
    "launch_protected_directories": [
      ".nddev-github-copilot-cli.lock",
      "bin",
      "software"
    ],
    "writable_runtime_directories_while_locked": [
      ".",
      "home",
      "cache",
      "runtime",
      "runtime/tmp",
      "runtime/xdg-config",
      "cache/xdg-cache",
      "runtime/xdg-state",
      "runtime/gh-config"
    ],
    "runtime_state_writable_while_locked": true,
    "lifecycle_mutations_blocked_while_launch_running": true,
    "blocks_user_managed_flags": [
      "--add-dir",
      "--add-github-mcp-tool",
      "--add-github-mcp-toolset",
      "--additional-mcp-config",
      "--agent",
      "--allow-all",
      "--allow-all-mcp-server-instructions",
      "--allow-all-paths",
      "--allow-all-tools",
      "--allow-all-urls",
      "--allow-tool",
      "--allow-url",
      "--ask-user",
      "--autopilot",
      "--available-tools",
      "--bash-env",
      "--config-dir",
      "--connect",
      "--context",
      "--deny-tool",
      "--deny-url",
      "--disable-builtin-mcps",
      "--disable-mcp-server",
      "--disallow-temp-dir",
      "--effort",
      "--enable-all-github-mcp-tools",
      "--enable-memory",
      "--max-autopilot-continues",
      "--mode",
      "--model",
      "--no-ask-user",
      "--no-remote",
      "--no-remote-export",
      "--no-sandbox",
      "--plan",
      "--reasoning-effort",
      "--remote",
      "--remote-export",
      "--resume",
      "--sandbox",
      "--worktree",
      "--yolo",
      "-C",
      "-w"
    ]
  },
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "update",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-plan",
      "software-status",
      "software-install",
      "software-update",
      "software-remove",
      "builder-status",
      "install-builder"
    ],
    "target_required": [
      "status",
      "plan",
      "install",
      "update",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-plan",
      "software-status",
      "software-install",
      "software-update",
      "software-remove",
      "builder-status",
      "install-builder",
      "launch"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>"
  },
  "transaction_policy": {
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "lock": "product bootstrap coordination lock derives the canonical target, then canonical-target external persistent 0600 lifecycle lock is acquired; target-internal persistent 0600 lifecycle lock is acquired only when needed; all use nonblocking fcntl.flock",
    "external_lock_root": "<resolved-fixed-system-temp>/nddev-github-copilot-cli-app.<uid>.bootstrap",
    "external_lock_path": "<external-lock-root>/nddev-github-copilot-cli-app.<sha256(product-namespace+canonical-target)>.lock",
    "external_lock_binding": "JSON payload binds schema, product namespace, lock kind, and canonical absolute target; mismatch fails closed",
    "external_lock_release": "persistent file is never unlinked by lifecycle operations; kernel flock release with stable inode is crash recovery",
    "lock_acquire_order": [
      "product-coordination",
      "canonical-target-external",
      "target-internal-when-needed"
    ],
    "lock_release_order": [
      "target-internal-when-held",
      "canonical-target-external"
    ],
    "lock_path": "<target>/.nddev-github-copilot-cli.lock/lifecycle.lock",
    "lock_parent_mode_while_held": "0500",
    "lock_recovery": "stale parent mode from manager crash is recovered after flock acquisition",
    "new_target_bootstrap_lock": "product bootstrap coordination plus canonical-target external persistent bootstrap lifecycle lock",
    "private_current_user_parent_required": true,
    "preserve_unmanaged_files": true,
    "reject_symlink_managed_files": true,
    "reject_hardlink_managed_files": true,
    "dangling_symlinks_fail_closed": true,
    "unique_stage_directories": true,
    "backup_pool_marker": "NDDEV-GITHUB-COPILOT-CLI-BACKUPS.json",
    "preexisting_backup_pool_collision": "fail-closed-no-delete",
    "created_transaction_paths_cleaned_exactly": true,
    "rollback_snapshot": "managed files restored by reversible rename with exact bytes, modes, inode, mtime, path/size/sha256 postconditions, and verified residue cleanup",
    "rollback_on_failure": true,
    "restore_absent_managed_paths": "remove-all-known-managed-paths-absent-from-validated-backup",
    "backup_slots": 10
  },
  "software_install": {
    "tested_version": "1.0.75",
    "supported_platforms": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "unsupported_platforms": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "source": "github.com/github/copilot-cli release assets",
    "installer": {
      "url": "https://gh.io/copilot-install",
      "sha256": "cd45508981a9baee5fb8f5e38495d315758cd7fea4a715b53a9f26c12544dc95",
      "size": 6922
    },
    "layout": {
      "visible_command": "bin/copilot",
      "software_manifest": "software/copilot-cli.json"
    },
    "update_precondition": "installed-or-safe-repairable-partial-target",
    "absent_update_policy": "domain-failure-install-first-zero-artifacts",
    "remove_precondition": "installed-safe-repairable-partial-or-absent-target",
    "absent_remove_policy": "no-op-zero-artifacts",
    "partial_remove_policy": "remove-repairable-manager-owned-software-only-fail-closed-on-unsafe-partial",
    "remove_scope": "manager-owned bin/copilot and software/copilot-cli.json only; setup, auth, and unrelated runtime state preserved",
    "stage_policy": "unique-private-mkdtemp-under-target-parent",
    "pre_network_preflight": "structured macos-or-ubuntu-glibc host preflight before target or stage creation and before installer network access",
    "commands": {
      "plan": "python3 cli-tools/nddev_github_copilot_cli.py software-plan --target <absolute-target> [--json]",
      "status": "python3 cli-tools/nddev_github_copilot_cli.py software-status --target <absolute-target> [--json]",
      "install": "python3 cli-tools/nddev_github_copilot_cli.py software-install --target <absolute-target> [--json]",
      "update": "python3 cli-tools/nddev_github_copilot_cli.py software-update --target <absolute-target> [--json]",
      "remove": "python3 cli-tools/nddev_github_copilot_cli.py software-remove --target <absolute-target> [--json]"
    }
  }
}
